# Postgres. On Vercel use Neon: DATABASE_URL = pooled URL, DIRECT_URL = direct URL (for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/house_design"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/house_design"

# Optional single shared password. Strongly recommended on a public Vercel URL,
# otherwise anyone with the link can use the app (and your Claude API credits).
APP_PASSWORD=""

# Claude API (milestone 3)
ANTHROPIC_API_KEY=""
